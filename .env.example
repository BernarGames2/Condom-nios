# Copie este arquivo para .env.local e preencha só o que precisar. Nunca publique o .env.local.
# Sem nenhuma variável, o site funciona: o formulário prepara o pedido por e-mail.

# Endereço público do site, sem barra no final (metadados, sitemap e robots).
# Na Vercel e na Netlify, se ficar vazio, vale o endereço que elas criam.
# NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# E-mail de contato e destino dos pedidos por e-mail (padrão: arantesbernardo432@gmail.com).
# NEXT_PUBLIC_CONTATO_EMAIL=contato@seudominio.com.br

# Quem responde pelos dados na política de privacidade (padrão: Bernardo).
# Troque pela razão social e pelo CNPJ quando a empresa existir.
# NEXT_PUBLIC_RESPONSAVEL=Bernardo

# Nome da hospedagem na política de privacidade (padrão: detecta Vercel ou Netlify).
# NEXT_PUBLIC_HOSPEDAGEM=Vercel

# Para onde vão os pedidos do formulário:
#   webhook  -> planilha do Google (veja integracoes/google-planilhas/LEIAME.md)
#   arquivo  -> arquivo local (só para desenvolvimento ou servidor com disco permanente)
#   vazio    -> em produção, o formulário prepara o pedido por e-mail
# PEDIDOS_DESTINO=webhook

# Usados quando PEDIDOS_DESTINO=webhook (segredo: só no servidor, nunca com NEXT_PUBLIC_).
# PEDIDOS_WEBHOOK_URL=https://script.google.com/macros/s/COLE_AQUI_O_ID/exec
# PEDIDOS_WEBHOOK_SEGREDO=troque-por-uma-frase-longa-e-aleatoria

# Usado quando PEDIDOS_DESTINO=arquivo.
# PEDIDOS_ARQUIVO=.dados/pedidos.jsonl

# Opcional: outros domínios autorizados a enviar o formulário, separados por vírgula
# (o próprio domínio do site já é aceito).
# ORIGENS_PERMITIDAS=

# Opcional: força o modo do formulário (email ou servidor).
# MODO_FORMULARIO=
